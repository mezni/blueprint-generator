# Root environment variables
# Copy this to .env and fill in your values

# Environment
ENVIRONMENT=development
APP_ENV=development
LOG_LEVEL=debug
LOG_FORMAT=json

# Service ports
SERVICE_PORT=3001

# Infrastructure connection strings
DATABASE_URL=postgres://borne:change-me@localhost:5432/bornemap
RABBITMQ_URL=amqp://borne:change-me@localhost:5672/
AUTH_SERVER_URL=http://localhost:8080/realms/ev-platform

# Secrets (change these in production)
POSTGRES_USER=borne
POSTGRES_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=borne
RABBITMQ_DEFAULT_PASS=change-me
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
