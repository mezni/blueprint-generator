{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Error Codes",
  "description": "Standard error codes used across all Bornemap API responses",
  "type": "string",
  "enum": [
    "UNAUTHENTICATED",
    "FORBIDDEN",
    "TOKEN_EXPIRED",
    "PARTNER_SCOPE_VIOLATION",
    "INSUFFICIENT_ROLE",
    "NOT_FOUND",
    "ALREADY_EXISTS",
    "SOFT_DELETED",
    "VALIDATION_FAILED",
    "INVALID_COORDINATES",
    "INVALID_STATE_TRANSITION",
    "ACTIVE_STATIONS_EXIST",
    "REVIEW_STATE_INVALID"
  ]
}
