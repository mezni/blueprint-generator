{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Envelope",
  "description": "Standard API response envelope for all Bornemap endpoints",
  "definitions": {
    "successEnvelope": {
      "type": "object",
      "required": ["success", "data", "meta"],
      "properties": {
        "success": { "const": true },
        "data": { "type": "object" },
        "meta": { "$ref": "#/definitions/paginationMeta" }
      }
    },
    "errorEnvelope": {
      "type": "object",
      "required": ["success", "error"],
      "properties": {
        "success": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "details": { "type": "object" }
          }
        }
      }
    },
    "paginationMeta": {
      "type": "object",
      "required": ["page", "size", "total", "total_pages", "has_next", "has_prev"],
      "properties": {
        "page": { "type": "integer", "minimum": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 0 },
        "total_pages": { "type": "integer", "minimum": 0 },
        "has_next": { "type": "boolean" },
        "has_prev": { "type": "boolean" }
      }
    }
  }
}
