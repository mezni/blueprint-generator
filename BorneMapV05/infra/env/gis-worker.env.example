# Platform DB connection (shared with admin-service)
PLATFORM_DB_HOST=postgres.internal
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=platform_db
PLATFORM_DB_USER=platform_user
PLATFORM_DB_PASSWORD=platform_pass

# Alternatively, use a single JDBC-style URL
# PLATFORM_DB_URL=postgres://platform_user:platform_pass@postgres.internal:5432/platform_db

# GIS Worker
GIS_WORKER_PORT=8084
GIS_WORKER_POLL_INTERVAL_MS=5000
GIS_WORKER_BATCH_SIZE=50
GIS_WORKER_MAX_RETRIES=3
GIS_WORKER_RETRY_BASE_DELAY_MS=1000
GIS_WORKER_STALE_PROCESSING_TIMEOUT_MS=30000
GIS_DEFAULT_SRID=4326

# Feature flag
FF_ENABLE_GIS_SYNC=true

# RabbitMQ (optional, for future use)
# RABBITMQ_QUEUE_GIS_SYNC=gis.sync
